+def _notify_queue_finished(exit_code):
+    """Push when automation exits because the queue is empty (not a planned restart)."""
+    if exit_code == getattr(app, "RESTART_EXIT_CODE", 75):
+        return
+    done = _processed_rows_count()
+    try:
+        total = len(load_clients(CLIENTS_FILE)) if CLIENTS_FILE.exists() else 0
+    except Exception:
+        total = 0
+    lines = [
+        "✅ <b>Работа завершена</b>",
+        f"Отработано строк: <b>{done}</b>",
+    ]
+    if total:
+        lines.append(f"В базе сейчас: {total}")
+    lines.append("")
+    lines.append("Можно загрузить новую базу:")
+    _send("\n".join(lines), reply_markup=DONE_UPLOAD_MARKUP)
+    print(f"[CTRL] QUEUE_DONE_1591R84: push отправлен, отработано={done}", flush=True)
