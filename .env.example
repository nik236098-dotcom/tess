# ——— Telegram ———
# Токен бота из @BotFather. Без него сервер работает только в режиме отладки.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Имя бота и короткое имя мини-приложения — из них собирается ссылка-приглашение.
TELEGRAM_BOT_USERNAME=PokerOk_bot
# Должно совпадать с Short name, который вы зададите в BotFather при /newapp.
TELEGRAM_APP_SHORT_NAME=poker

# ——— Админы ———
# Telegram ID тех, кто выдаёт фишки. Несколько — через запятую.
# Свой ID видно в лобби приложения; ещё его скажет @userinfobot.
TELEGRAM_ADMIN_IDS=8552698215

# ——— Экономика ———
# Все суммы внутри сервера — целые центы: 10000 = $100.00.
# Столько получает новый игрок при первом входе.
START_BALANCE=10000

# ——— Пополнение и вывод ———
# Кнопки «Пополнить» и «Вывести» появляются на главной сами, как только задан
# хотя бы один токен ниже. Не задано ничего — они выключены.

# Crypto Bot: @CryptoBot → Crypto Pay → My Apps → Create App → API Token.
# CRYPTOBOT_TOKEN=12345:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Тестовая сеть (@CryptoTestnetBot) — для проверки без настоящих денег.
# CRYPTOBOT_TESTNET=1

# xRocket: @xRocket → Rocket Pay → Create App → API token.
# XROCKET_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# XROCKET_TESTNET=1

# Монета, в которой выставляются счета. У xRocket TON называется TONCOIN.
TOPUP_CURRENCY=USDT
# Можно задать монету отдельно для каждого сервиса:
# CRYPTOBOT_CURRENCY=USDT
# XROCKET_CURRENCY=TONCOIN

# Сколько долларов даёт одна единица валюты. 1 USDT = $1.00, курс 1:1
# работает в обе стороны — и на пополнение, и на вывод.
# Менять имеет смысл только вместе с TOPUP_CURRENCY: для TONCOIN курс другой.
TOPUP_USD_PER_UNIT=1
# Кнопки быстрых сумм в лобби.
TOPUP_PRESETS=1,5,10,25
# Границы суммы одного пополнения, в единицах валюты.
TOPUP_MIN_AMOUNT=0.1
TOPUP_MAX_AMOUNT=1000

# Минимальная сумма вывода, в долларах.
WITHDRAW_MIN_AMOUNT=1

# Куда вернуть игрока после оплаты — ссылка на ваш мини-апп (необязательно).
# TOPUP_RETURN_URL=https://t.me/PokerOk_bot/poker

# ВАЖНО: адрес для вебхука прописывается в настройках приложения внутри
# самого бота (Crypto Bot: My Apps → Webhooks; xRocket: настройки приложения):
#   https://ваш-домен/pay/cryptobot/webhook
#   https://ваш-домен/pay/xrocket/webhook
# Без вебхука пополнение тоже работает: мини-апп сам опрашивает статус счёта,
# пока открыт. Но с вебхуком фишки приходят даже при закрытом приложении.

# ——— Промокоды ———
# Коды создаёт админ прямо в чате стола:
#   /промокод ЛЕТО 5 100   — код ЛЕТО на $5.00, 100 активаций
#   /промокоды             — список
#   /удалить-код ЛЕТО      — убрать
# Один игрок активирует код ровно один раз. Хранятся в promo.json.

# ——— Ссылки на главной ———
# Карточка «Другие игры» и кнопка поддержки. Не задано — не показываются.
# COMMUNITY_URL=https://t.me/ваш_чат
# SUPPORT_URL=https://t.me/ваша_поддержка

# ——— Сервер ———
PORT=3000
# Где хранить балансы (файл accounts.json создастся внутри).
DATA_DIR=/var/lib/poker

# Разрешить вход по имени без Telegram. Только для локальной отладки!
# ALLOW_DEV_LOGIN=1
