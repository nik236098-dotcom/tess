# Токен бота из @BotFather — без него сервер работает только в режиме отладки.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Нужны для кнопки «позвать друзей»: из них собирается ссылка t.me.
TELEGRAM_BOT_USERNAME=my_poker_bot
TELEGRAM_APP_SHORT_NAME=poker

# Порт HTTP-сервера.
PORT=3000

# Разрешить вход по имени без Telegram (удобно для отладки, в проде не включать).
# ALLOW_DEV_LOGIN=1
